# Copy this file to .env and fill in real values. Never commit .env.

# Groq API key used by DecisionEngine's AI provider (free tier: https://console.groq.com)
GROQ_API_KEY=

# Which AI provider DecisionEngine uses: "Groq" or "Stub" (deterministic, no network calls)
AI_PROVIDER=Groq

# Flat auto-approval ceiling fallback, in USD (overridden by the per-category policy engine)
AUTO_APPROVE_CEILING=1000
