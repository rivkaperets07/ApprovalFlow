# Copy this file to .env (same folder as docker-compose.yml) and fill in real values.
# docker compose reads .env automatically for the ${VAR} substitutions below. Never commit .env.

# Groq API key used by DecisionEngine's AI provider (free tier: https://console.groq.com).
# Passed to the decision-engine-sidecar container, where the secretstores.local.env Dapr
# component reads it and exposes it to GroqAiModelProvider via DaprClient.GetSecretAsync.
GROQ_API_KEY=

# Which AI provider DecisionEngine uses: "Groq" or "Stub" (deterministic, no network calls;
# used automatically in tests/CI so builds never depend on a live LLM or rate limits).
AI_PROVIDER=Stub

# N1: HMAC-SHA256 key the Gateway uses to sign/validate the demo JWTs (min 32 chars).
# Leave empty to use the built-in local-demo default; set a real value anywhere shared.
JWT_SIGNING_KEY=
