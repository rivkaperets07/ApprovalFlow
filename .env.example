# Copy this file to .env and fill in real values. Never commit .env.

# Groq API key used by DecisionEngine's AI provider (free tier: https://console.groq.com)
GROQ_API_KEY=

# Which AI provider DecisionEngine uses: "Groq" or "Stub" (deterministic, no network calls,
# used automatically in tests/CI). Must match the config key name exactly (no underscore).
AiProvider=Stub
